# OS / editor
.DS_Store
.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/

# ADK local session data (created by `adk web`)
.adk/

# Secrets — never commit API keys (Gemini, Groq, HF, etc.)
.env
*.key

# Data — download locally per data/README.md
# (keep the folder, its docs, and the small MedAESQA methods reference)
data/*
!data/.gitkeep
!data/README.md
!data/MedAESQA_methods_M1-M30.xlsx

# Keep small curated-set documentation and freeze metadata visible to Git.
!data/curated_baseline/
data/curated_baseline/*
!data/curated_baseline/README.md
!data/curated_baseline/selection_manifest.json
!data/curated_baseline/REVIEW_AND_FREEZE.md
!data/curated_baseline/source_review_annotations.jsonl
!data/curated_baseline/freeze_manifest.json

